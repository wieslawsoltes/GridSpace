<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(GridSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>GridSpace</ApplicationTitle><ApplicationId>io.github.wieslawsoltes.gridspace</ApplicationId>
    <ApplicationDisplayVersion>0.4.0</ApplicationDisplayVersion><ApplicationVersion>3</ApplicationVersion>
    <ApplicationPublisher>GridSpace contributors</ApplicationPublisher><Description>Local-first spreadsheet built with Uno Platform and SkiaSharp.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsPackable>false</IsPackable>
    <UnoDisableHotDesign>true</UnoDisableHotDesign><UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <RunAOTCompilation>false</RunAOTCompilation><WasmShellGenerateAOTProfile>false</WasmShellGenerateAOTProfile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../GridSpace.Workbench/GridSpace.Workbench.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'"><EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Storage.js" /></ItemGroup>
</Project>
